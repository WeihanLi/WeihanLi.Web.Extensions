<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AspNet11PackageVersion>11.0.0</AspNet9PackageVersion>
    <AspNet10PackageVersion>10.0.15</AspNet10PackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Condition="'$(TargetFramework)'=='net11.0'" Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="$(AspNet11PackageVersion)" />
    <PackageVersion Condition="'$(TargetFramework)'=='net10.0'" Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="$(AspNet10PackageVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="$(AspNet11PackageVersion)" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.20.0" />
    <PackageVersion Include="WeihanLi.Common" Version="1.0.94" />
  </ItemGroup>
</Project>
